# 이 파일을 복사해 .env로 사용하세요: cp .env.example .env
# 실제 값이 담긴 .env는 절대 커밋하지 마세요.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (docker-compose 기본값과 일치, 호스트 포트는 5434) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/contactapp?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=14d

# --- SMS OTP (개발 중에는 mock 처리 가능) ---
SMS_API_KEY=
SMS_API_SECRET=

# --- AI 메일 초안 (Anthropic, 미사용) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- AI 연락 초안 생성 (Gemini) --- https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- 메일 발송 (이메일 가입 인증코드) — Gmail 계정 + 앱 비밀번호(2단계 인증 켠 뒤 발급) 사용 ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- 메일 발송 ---
MAIL_SEND_API_KEY=

# BLE 태깅용 임시 코드는 별도 시크릿 없이 서버 메모리에서 관리됩니다 (lib/bleCodeStore.ts 참고).

# --- Google Login (Google Cloud Console > OAuth Client ID: Web/iOS/Android 각각 발급 후 콤마로 연결) ---
GOOGLE_CLIENT_IDS=xxxx-web.apps.googleusercontent.com,xxxx-ios.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com

# --- Gmail 발송 대행 (사용자가 자기 대신 이메일 보내도록 위임) ---
# Google Cloud Console > OAuth Client ID (Web application) 하나 별도 발급, redirect URI를 아래와 정확히 일치시켜 등록
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/mail/gmail/callback
# 테스트 모드: 콤마로 구분된 허용 이메일만 Gmail 연동 가능 (비어있으면 아무도 연동 불가)
GMAIL_ALLOWED_TEST_EMAILS=you@example.com
