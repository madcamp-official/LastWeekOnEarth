# 이 파일을 복사해 .env로 사용하세요: cp .env.example .env
# 실제 값이 담긴 .env는 절대 커밋하지 마세요.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (docker-compose 기본값과 일치) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contactapp?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=14d

# --- SMS OTP (개발 중에는 mock 처리 가능) ---
SMS_API_KEY=
SMS_API_SECRET=

# --- AI 메일 초안 (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- 메일 발송 ---
MAIL_SEND_API_KEY=

# --- BLE 임시 토큰 ---
BLE_TOKEN_SECRET=change-me-ble-secret
BLE_TOKEN_EXPIRES_IN=5m
