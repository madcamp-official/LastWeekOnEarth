// CLAUDE.md 섹션 2 스키마를 기준으로 하되, 아래 항목을 보강했습니다:
// 1) RefreshToken 모델 추가 — 섹션 3에서 "DB에 refreshToken 해시 저장" 요구사항이 있으나
//    원본 스키마에 테이블이 없어 추가함 (로그아웃 시 개별 무효화 가능)
// 2) 외래키 컬럼에 @@index 추가 — Prisma는 FK에 자동 인덱스를 걸지 않으므로 조회 성능을 위해 명시
// 3) 소유 관계에 onDelete: Cascade 지정 — 유저/연락처 삭제 시 하위 레코드가 고아로 남지 않도록 함
//    (Notification.contactId는 원본처럼 느슨한 참조로 유지: BLE 태깅 등에서 유연하게 쓰기 위함)
// 4) enum -> String: 로컬 개발에 Docker/PostgreSQL이 없어 SQLite로 임시 전환했는데, SQLite 커넥터는
//    네이티브 enum을 지원하지 않아 전부 String으로 바꾸고 허용값은 애플리케이션(zod)에서 검증한다.
//    실배포 시 postgresql로 되돌리면서 enum도 함께 복원할 것.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String?
  name          String
  affiliation   String
  email         String   @unique
  emailVerified Boolean  @default(false)
  phone         String?  @unique
  phoneVerified Boolean  @default(false)
  googleId      String?  @unique
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contactsOwned      Contact[]            @relation("OwnerContacts")
  contactsTagged     Contact[]            @relation("TargetUser")
  groups             ContactGroup[]
  cvEntries          CvEntry[]
  mailDrafts         EmailDraft[]
  mailBatches        EmailBatch[]
  notifications      Notification[]
  phoneVerifications PhoneVerification[]
  refreshTokens      RefreshToken[]
  emails             UserEmail[]
}

// 사용자가 등록한 여러 이메일 (구글 로그인 계정 외 학교 도메인 이메일 등). isPrimary인 값은
// User.email과 항상 동기화한다 (로그인/유니크 매칭 등 기존 코드가 User.email 하나만 보기 때문).
model UserEmail {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PhoneVerification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  phone     String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([userId])
}

// ContactSource: "MANUAL" | "BLE"
model Contact {
  id              String    @id @default(uuid())
  ownerUserId     String
  owner           User      @relation("OwnerContacts", fields: [ownerUserId], references: [id], onDelete: Cascade)
  targetUserId    String?
  targetUser      User?     @relation("TargetUser", fields: [targetUserId], references: [id])
  name            String
  affiliation     String?
  email           String?
  phone           String?
  memo            String?
  photoUrl        String?
  source          String    @default("MANUAL")
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  groupMemberships ContactGroupMember[]
  logs             ContactLog[]
  mailDrafts       EmailDraft[]
  emails           ContactEmail[]

  @@index([ownerUserId])
  @@index([targetUserId])
}

// 인맥이 가진 여러 이메일. isPrimary인 값은 Contact.email과 항상 동기화한다.
model ContactEmail {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email     String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([contactId, email])
  @@index([contactId])
}

model ContactGroup {
  id            String   @id @default(uuid())
  ownerUserId   String
  owner         User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name          String
  frequencyDays Int
  createdAt     DateTime @default(now())

  members       ContactGroupMember[]
  notifications Notification[]

  @@index([ownerUserId])
}

model ContactGroupMember {
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedAt   DateTime     @default(now())

  @@id([groupId, contactId])
  @@index([contactId])
}

// LogChannel: "EMAIL" | "CALL" | "MEETING" | "OTHER"
model ContactLog {
  id          String   @id @default(uuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel     String
  memo        String?
  contactedAt DateTime @default(now())

  @@index([contactId])
}

// CvSource: "MANUAL" | "SOCIAL"
model CvEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  source    String   @default("MANUAL")
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailBatch {
  id          String   @id @default(uuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  label       String
  createdAt   DateTime @default(now())

  drafts EmailDraft[]

  @@index([ownerUserId])
}

// DraftStatus: "DRAFT" | "SCHEDULED" | "SENT"
model EmailDraft {
  id          String      @id @default(uuid())
  ownerUserId String
  owner       User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?    @relation(fields: [contactId], references: [id])
  batchId     String?
  batch       EmailBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  subject     String
  body        String
  status      String      @default("DRAFT")
  scheduledAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([ownerUserId])
  @@index([contactId])
  @@index([batchId])
}

// NotificationType: "CONTACT_REMINDER"
model Notification {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId   String?
  groupId     String?
  group       ContactGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type        String
  scheduledAt DateTime
  sent        Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([groupId])
  @@index([scheduledAt, sent])
}
