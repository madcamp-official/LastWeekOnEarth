// CLAUDE.md 섹션 2 스키마를 기준으로 하되, 아래 항목을 보강했습니다:
// 1) RefreshToken 모델 추가 — 섹션 3에서 "DB에 refreshToken 해시 저장" 요구사항이 있으나
//    원본 스키마에 테이블이 없어 추가함 (로그아웃 시 개별 무효화 가능)
// 2) 외래키 컬럼에 @@index 추가 — Prisma는 FK에 자동 인덱스를 걸지 않으므로 조회 성능을 위해 명시
// 3) 소유 관계에 onDelete: Cascade 지정 — 유저/연락처 삭제 시 하위 레코드가 고아로 남지 않도록 함
//    (Notification.contactId는 원본처럼 느슨한 참조로 유지: BLE 태깅 등에서 유연하게 쓰기 위함)
// 4) enum -> String: 로컬 개발에 Docker/PostgreSQL이 없어 SQLite로 임시 전환했는데, SQLite 커넥터는
//    네이티브 enum을 지원하지 않아 전부 String으로 바꾸고 허용값은 애플리케이션(zod)에서 검증한다.
//    실배포 시 postgresql로 되돌리면서 enum도 함께 복원할 것.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String?
  name          String
  affiliation   String
  email         String   @unique
  emailVerified Boolean  @default(false)
  phone         String?  @unique
  phoneVerified Boolean  @default(false)
  googleId      String?  @unique
  avatarUrl     String?
  // Expo push token — 연락 리마인더 등 푸시 알림 발송 대상. 로그인 기기가 바뀌면 최신 값으로 덮어쓴다.
  expoPushToken String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contactsOwned      Contact[]           @relation("OwnerContacts")
  contactsTagged     Contact[]           @relation("TargetUser")
  groups             ContactGroup[]
  cvEntries          CvEntry[]
  mailDrafts         EmailDraft[]
  mailBatches        EmailBatch[]
  notifications      Notification[]
  phoneVerifications PhoneVerification[]
  refreshTokens      RefreshToken[]
  emails             UserEmail[]
  posts              Post[]
  postLikes          PostLike[]
  postComments       PostComment[]
  gmailAuthorization GmailAuthorization?
  sentMessages       Message[]           @relation("MessageSender")
  receivedMessages   Message[]           @relation("MessageReceiver")
  sharedInMessages   Message[]           @relation("MessageSharedProfile")
  notificationsCaused Notification[]     @relation("NotificationActor")
}

// 사용자가 "내 대신 Gmail 발송" 권한을 부여한 상태 저장 (OAuth offline access refresh token).
// 테스트 모드에서는 config/env.ts의 GMAIL_ALLOWED_TEST_EMAILS 허용 목록에 있는 사용자만 연결 가능.
model GmailAuthorization {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String
  grantedEmail String
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 소식(진짜 소셜 피드): 계정을 가진 사람만 쓸 수 있고, "이웃"(BLE로 연결됐거나 이메일이 일치해서
// 서로 계정이 매칭된 인맥)만 볼 수 있다. posts.routes.ts의 neighborUserIds 계산 참고.
model Post {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  photoUrl  String?
  createdAt DateTime @default(now())

  likes         PostLike[]
  comments      PostComment[]
  messages      Message[]
  notifications Notification[]

  @@index([authorId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
}

// 소식 "답장"은 댓글이 아니라 작성자에게 보내는 1:1 디엠이 된다 (postId는 어떤 소식에서
// 시작된 대화인지 참고용으로만 남기고, 스레드 자체는 sender/receiver 쌍으로 식별한다).
model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  // 텍스트/사진/프로필 공유 중 최소 하나는 채워진다 (zod에서 검증). content는 사진/프로필만
  // 보낼 때는 빈 문자열일 수 있다.
  content    String   @default("")
  photoUrl   String?
  sharedProfileId String?
  sharedProfile   User? @relation("MessageSharedProfile", fields: [sharedProfileId], references: [id], onDelete: SetNull)
  // 계정 없이 수동 등록만 된 주소록 인맥도 공유할 수 있도록 User가 아닌 Contact를 직접 참조한다.
  sharedContactId String?
  sharedContact   Contact? @relation(fields: [sharedContactId], references: [id], onDelete: SetNull)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  notifications Notification[]

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// 사용자가 등록한 여러 이메일 (구글 로그인 계정 외 학교 도메인 이메일 등). isPrimary인 값은
// User.email과 항상 동기화한다 (로그인/유니크 매칭 등 기존 코드가 User.email 하나만 보기 때문).
model UserEmail {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PhoneVerification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  phone     String
  otpCode   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([userId])
}

// 이메일 회원가입 시 실존 메일인지 확인하기 위한 인증코드. PhoneVerification과 같은 모양이지만
// 계정이 생기기 전(가입 단계)에도 써야 해서 userId 없이 email만으로 발급/조회한다.
model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ContactSource: "MANUAL" | "BLE"
model Contact {
  id                   String    @id @default(uuid())
  ownerUserId          String
  owner                User      @relation("OwnerContacts", fields: [ownerUserId], references: [id], onDelete: Cascade)
  targetUserId         String?
  targetUser           User?     @relation("TargetUser", fields: [targetUserId], references: [id])
  name                 String
  affiliation          String?
  email                String?
  phone                String?
  memo                 String?
  photoUrl             String?
  contactMethod        String    @default("OTHER")
  source               String    @default("MANUAL")
  // 인맥 목록 화면에서 사용자가 드래그로 직접 정한 순서. 낮을수록 위에 온다.
  sortOrder            Int       @default(0)
  lastContactedAt      DateTime?
  // 이 기간(일)이 지나도록 연락이 없으면 푸시 알림으로 리마인드한다 (기본 90일 = 3개월).
  reminderIntervalDays Int       @default(90)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  groupMemberships ContactGroupMember[]
  logs             ContactLog[]
  mailDrafts       EmailDraft[]
  emails           ContactEmail[]
  sharedInMessages Message[]

  @@index([ownerUserId])
  @@index([targetUserId])
}

// 인맥이 가진 여러 이메일. isPrimary인 값은 Contact.email과 항상 동기화한다.
model ContactEmail {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email     String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([contactId, email])
  @@index([contactId])
}

model ContactGroup {
  id            String   @id @default(uuid())
  ownerUserId   String
  owner         User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name          String
  frequencyDays Int
  createdAt     DateTime @default(now())

  members       ContactGroupMember[]
  notifications Notification[]
  mailDrafts    EmailDraft[]

  @@index([ownerUserId])
}

model ContactGroupMember {
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedAt   DateTime     @default(now())

  @@id([groupId, contactId])
  @@index([contactId])
}

// LogChannel: "EMAIL" | "CALL" | "MEETING" | "OTHER"
model ContactLog {
  id          String   @id @default(uuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel     String
  memo        String?
  contactedAt DateTime @default(now())

  @@index([contactId])
}

// CvSource: "MANUAL" | "SOCIAL"
model CvEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  source    String   @default("MANUAL")
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailBatch {
  id          String   @id @default(uuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  label       String
  createdAt   DateTime @default(now())

  drafts EmailDraft[]

  @@index([ownerUserId])
}

// DraftStatus: "DRAFT" | "SCHEDULED" | "SENT"
model EmailDraft {
  id          String        @id @default(uuid())
  ownerUserId String
  owner       User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id])
  // 그룹에게 보내는 "공통 초안 1개"일 때만 채워진다 (contactId는 이 경우 null).
  groupId     String?
  group       ContactGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  batchId     String?
  batch       EmailBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  subject     String
  body        String
  // "EMAIL" | "TEXT" — 이메일 초안인지 문자(SMS/카카오 등) 초안인지
  channel     String        @default("EMAIL")
  status      String        @default("DRAFT")
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([ownerUserId])
  @@index([contactId])
  @@index([groupId])
  @@index([batchId])
}

// NotificationType: "CONTACT_REMINDER" | "POST_LIKE" | "DM_MESSAGE"
model Notification {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId   String?
  groupId     String?
  group       ContactGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // 알림을 유발한 상대방 (좋아요 누른 사람, 디엠 보낸 사람 등). CONTACT_REMINDER는 null.
  actorId     String?
  actor       User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  messageId   String?
  message     Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type        String
  scheduledAt DateTime
  sent        Boolean       @default(false)
  read        Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([groupId])
  @@index([scheduledAt, sent])
  @@index([actorId])
  @@index([postId])
  @@index([messageId])
}
