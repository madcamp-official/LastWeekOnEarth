{
  "expo": {
    "name": "Anchora",
    "slug": "lastweekonearth",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.lastweekonearth.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "주변 사용자를 태깅하기 위해 블루투스를 사용합니다."
      }
    },
    "android": {
      "package": "com.lastweekonearth.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.303266548663-a0agmdvgpoc0llfc4ctn6vh314rtdlg7"
        }
      ]
    ]
  }
}
