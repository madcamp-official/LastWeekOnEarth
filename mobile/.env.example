# 이 파일을 복사해 .env로 사용하세요: cp .env.example .env
# Google Cloud Console > OAuth Client ID에서 발급받은 값을 채워주세요.
#
# 네이티브 빌드(react-native-config)는 접두사 없는 변수를 읽고,
# 웹 빌드(Expo/Metro)는 EXPO_PUBLIC_ 접두사가 붙은 변수만 번들에 인라인합니다.
# 그래서 같은 값을 두 이름으로 각각 채워야 합니다.

API_BASE_URL=http://localhost:4000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Google Cloud Console > OAuth Client ID > Web application (웹 프리뷰 + 서버 idToken 검증용)
GOOGLE_WEB_CLIENT_ID=xxxx-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx-web.apps.googleusercontent.com

# Google Cloud Console > OAuth Client ID > iOS application (Bundle ID 등록 필요, ios/ 생성 후 발급)
GOOGLE_IOS_CLIENT_ID=xxxx-ios.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx-ios.apps.googleusercontent.com

# Android는 Cloud Console에 패키지명 + SHA-1 지문만 등록하면 별도 client ID 없이도 동작하지만,
# expo-auth-session 사용 시에는 Android client ID도 필요합니다 (android/ 생성 후 발급).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx-android.apps.googleusercontent.com
